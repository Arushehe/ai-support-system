# Copy to .env and fill in, or export these as real environment variables.

# --- LLM backend selection ---
# "groq" (default, needs a free API key) or "ollama" (fully local, no key)
LLM_PROVIDER=groq

# Free tier key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Only used when LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- App config ---
TICKETS_CSV_PATH=data/support_tickets.csv
API_BASE_URL=http://localhost:8000
